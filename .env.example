# ── Administration de la boutique ──────────────────────────────
# Mot de passe de connexion à /admin (obligatoire en production).
ADMIN_PASSWORD=changez-moi

# Secret de signature des cookies de session.
# Générer avec : openssl rand -base64 32
SESSION_SECRET=changez-moi-aussi

# ── Base de données ────────────────────────────────────────────
# Chaîne de connexion Neon (Postgres). Obligatoire en production :
# sans elle, l'administration ne peut pas enregistrer les produits.
# DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
